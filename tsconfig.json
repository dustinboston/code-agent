{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022"
    ],
    "types": [
      "bun",
      "node"
    ]
  },
  "include": [
    "src"
  ]
}