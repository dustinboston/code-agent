{
  "name": "code-agent",
  "version": "0.1.0",
  "description": "Code Agent - Interactive CLI chat with LangChain, Pinecone, and Claude",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "code-agent": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "test": "vitest"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.0.0",
    "@langchain/community": "^1.0.0",
    "@langchain/core": "^1.0.0",
    "@langchain/google": "^0.1.9",
    "@langchain/openai": "^1.0.0",
    "@langchain/pinecone": "^1.0.0",
    "@langchain/textsplitters": "^1.0.1",
    "@pinecone-database/pinecone": "^5.1.2",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "ink": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "langchain": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.2.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "prettier": {
    "printWidth": 120
  }
}
