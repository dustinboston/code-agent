{
  "name": "code-agent",
  "version": "1.0.1",
  "description": "Code Agent is an AI-powered command-line interface (CLI) application with an interactive terminal user interface (TUI) designed to assist with software engineering tasks.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ca": "./bin/ca"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --compile --outfile bin/ca",
    "test": "bun test ./src/",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.0.0",
    "@langchain/community": "^1.0.0",
    "@langchain/core": "^1.0.0",
    "@langchain/google": "^0.1.9",
    "@langchain/openai": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "langchain": "^1.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.4",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "@types/bun": "latest"
  },
  "prettier": {
    "printWidth": 120
  },
  "license": "CC-BY-NC-4.0",
  "module": "src/index.ts",
  "private": true
}
